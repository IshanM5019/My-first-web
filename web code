    <!-- JavaScript for Firebase, Mobile Menu, and Form Handling -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        // NOTE: Added 'doc' and 'updateDoc' for lead status management
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, setLogLevel, query, onSnapshot, doc, updateDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Set Firebase logging level for debugging
        setLogLevel('Debug');

        let db;
        let auth;
        let userId = 'anonymous'; // Default ID
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        
        // --- Gemini API Schema Definition ---
        const responseSchema = {
            type: "OBJECT",
            properties: {
                qualificationSummary: {
                    type: "STRING",
                    description: "A one-sentence summary classifying the lead (e.g., 'High-Value SEO Strategy Prospect', 'Small Budget Social Media Management')."
                },
                keyNeeds: {
                    type: "ARRAY",
                    items: { type: "STRING" },
                    description: "3-5 bullet points outlining the client's key marketing needs/challenges based on the project details."
                },
                draftEmailSubject: {
                    type: "STRING",
                    description: "A concise, professional subject line for the follow-up email."
                },
                draftEmailBody: {
                    type: "STRING",
                    description: "A complete, personalized, and professional email body (using line breaks) for the agency owner to send back."
                }
            },
            propertyOrdering: ["qualificationSummary", "keyNeeds", "draftEmailSubject", "draftEmailBody"]
        };

        // --- Gemini API Utility Function with Exponential Backoff ---
        async function callGeminiApi(userQuery, systemPrompt, schema) {
            const apiKey = ""; // API key will be provided by the environment
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: schema
                },
            };

            let responseJson = null;
            let retries = 0;
            const maxRetries = 5;

            while (retries < maxRetries) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        if (response.status === 429 && retries < maxRetries - 1) {
                            const delay = Math.pow(2, retries) * 1000 + Math.random() * 1000;
                            await new Promise(resolve => setTimeout(resolve, delay));
                            retries++;
                            continue; 
                        }
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const result = await response.json();
                    const candidate = result.candidates?.[0];

                    if (candidate && candidate.content?.parts?.[0]?.text) {
                        const jsonText = candidate.content.parts[0].text;
                        responseJson = JSON.parse(jsonText);
                        return responseJson;
                    } else {
                        throw new Error("Invalid response structure from Gemini API.");
                    }

                } catch (error) {
                    console.error("Gemini API call failed:", error);
                    responseJson = { error: error.message };
                    break; 
                }
            }
            return responseJson;
        }


        // --- Firestore Status Utilities ---
        function getStatusColorClass(status) {
            switch (status) {
                case 'New': return 'text-primary-blue bg-primary-blue/10';
                case 'Contacted': return 'text-yellow-600 bg-yellow-100';
                case 'Qualified': return 'text-accent-teal bg-accent-teal/10';
                case 'Closed (Won)': return 'text-green-600 bg-green-100';
                case 'Closed (Lost)': return 'text-gray-500 bg-gray-100';
                default: return 'text-gray-800 bg-white';
            }
        }
        function getStatusBorderClass(status) {
            switch (status) {
                case 'New': return 'border-primary-blue';
                case 'Contacted': return 'border-yellow-500';
                case 'Qualified': return 'border-accent-teal';
                case 'Closed (Won)': return 'border-green-500';
                case 'Closed (Lost)': return 'border-gray-500';
                default: return 'border-gray-300';
            }
        }

        // --- Firestore Status Update Function ---
        async function updateLeadStatus(leadId, newStatus) {
            if (!db || !userId) {
                console.error("Database or User ID not ready for updating lead status.");
                return;
            }
            const docRef = doc(db, `artifacts/${appId}/users/${userId}/agency_leads`, leadId);
            try {
                await updateDoc(docRef, {
                    status: newStatus,
                    updatedAt: new Date()
                });
                console.log(`Lead ${leadId} status updated to ${newStatus}`);
            } catch (error) {
                console.error("Error updating lead status:", error);
            }
        }

        // --- Dashboard Visibility Toggler ---
        function setDashboardVisibility(isVisible) {
            const dashboardContainer = document.getElementById('leads-viewer-container');
            const adminLinks = document.querySelectorAll('.admin-link'); 
            
            if (dashboardContainer) {
                dashboardContainer.classList.toggle('hidden', !isVisible);
            }
            adminLinks.forEach(link => {
                link.classList.toggle('hidden', !isVisible);
            });
        }


        // --- Firebase Initialization and Authentication ---
        async function initializeFirebase() {
            try {
                const firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}');
                if (Object.keys(firebaseConfig).length === 0) {
                    console.error("Firebase config is missing or invalid.");
                    return;
                }

                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                // Try to sign in with custom token (Owner) or anonymously (Public Visitor)
                const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                if (initialAuthToken) {
                    // This is the owner's session (in this environment)
                    await signInWithCustomToken(auth, initialAuthToken);
                    console.log("Signed in with custom token (Owner).");
                } else {
                    // This is a public session (real world)
                    await signInAnonymously(auth);
                    console.log("Signed in anonymously (Public Visitor).");
                }

                onAuthStateChanged(auth, (user) => {
                    if (user) {
                        userId = user.uid;
                        document.getElementById('display-user-id').textContent = userId;
                        // Determine if the user has a long-term token (simulating the owner)
                        const isOwnerSession = !!initialAuthToken; 
                        
                        // Show the dashboard and admin links only for the owner
                        setDashboardVisibility(isOwnerSession); 

                        // Only load leads if this is the owner's session
                        if (isOwnerSession) {
                             loadLeads(); 
                        }
                    } else {
                        // If auth state changes to signed out (shouldn't happen here, but good practice)
                        userId = crypto.randomUUID(); 
                        document.getElementById('display-user-id').textContent = userId;
                        setDashboardVisibility(false); 
                    }
                });

            } catch (error) {
                console.error("Error initializing Firebase:", error);
            }
        }
        
        // --- Lead Management Logic ---
        function loadLeads() {
            if (!db || !userId) {
                console.warn("Database or User ID not ready for loading leads.");
                return;
            }

            const leadsListContainer = document.getElementById('leads-list');
            const leadsStatus = document.getElementById('leads-status');
            const collectionPath = `artifacts/${appId}/users/${userId}/agency_leads`;
            const leadsQuery = collection(db, collectionPath);
            
            // Set up real-time listener for leads
            onSnapshot(leadsQuery, (snapshot) => {
                const leads = [];
                // 1. Initialize KPIs
                let kpis = { total: 0, new: 0, contacted: 0, qualified: 0 };

                snapshot.forEach(doc => {
                    const leadData = { id: doc.id, status: 'New', ...doc.data() }; 
                    leads.push(leadData);

                    // Update KPIs
                    kpis.total++;
                    const status = leadData.status || 'New';
                    if (status === 'New') kpis.new++;
                    if (status === 'Contacted') kpis.contacted++;
                    if (status === 'Qualified' || status === 'Closed (Won)') kpis.qualified++; // Count won leads as qualified too
                });

                // 2. Update KPI display
                document.getElementById('kpi-total').textContent = kpis.total;
                document.getElementById('kpi-new').textContent = kpis.new;
                document.getElementById('kpi-qualified').textContent = kpis.qualified;


                leadsListContainer.innerHTML = ''; // Clear existing list

                if (leads.length === 0) {
                    leadsStatus.textContent = "No inquiries submitted yet.";
                } else {
                    leadsStatus.textContent = `Displaying ${leads.length} total inquiries. (Click ✨ to analyze)`;
                    
                    // Sort leads by submittedAt descending (newest first)
                    leads.sort((a, b) => {
                        const dateA = a.submittedAt?.toDate ? a.submittedAt.toDate().getTime() : 0;
                        const dateB = b.submittedAt?.toDate ? b.submittedAt.toDate().getTime() : 0;
                        return dateB - dateA;
                    });

                    leads.forEach(lead => {
                        const date = lead.submittedAt?.toDate ? lead.submittedAt.toDate().toLocaleDateString() : 'N/A';
                        const time = lead.submittedAt?.toDate ? lead.submittedAt.toDate().toLocaleTimeString() : '';
                        
                        // Get the current status, defaulting to 'New' if not set
                        const currentStatus = lead.status || 'New';

                        // Prepare lead data for the button, handling potential quotes in projectDetails
                        const leadDataJson = JSON.stringify({
                            name: lead.name,
                            email: lead.email,
                            phone: lead.phone || 'N/A', // Include new phone field
                            company: lead.company,
                            projectDetails: lead.projectDetails
                        }).replace(/'/g, '&apos;'); // Escape single quotes for HTML attribute
                        
                        const phoneDisplay = lead.phone ? `<p class="text-sm text-gray-600 mb-1">Phone: <span class="font-semibold">${lead.phone}</span></p>` : '';


                        // Status Dropdown HTML generation
                        const allStatuses = ['New', 'Contacted', 'Qualified', 'Closed (Won)', 'Closed (Lost)'];
                        const statusOptions = allStatuses.map(status => `
                            <option value="${status}" ${status === currentStatus ? 'selected' : ''}>
                                ${status}
                            </option>
                        `).join('');

                        const leadCard = `
                            <div class="bg-white p-6 rounded-xl shadow-lg border-l-4 ${getStatusBorderClass(currentStatus)} flex flex-col justify-between" data-lead-id="${lead.id}">
                                <div>
                                    <p class="text-xs text-gray-500 mb-2">${date} ${time}</p>
                                    <h4 class="text-lg font-bold text-gray-900">${lead.name} (${lead.company})</h4>
                                    <p class="text-sm text-accent-teal mb-1">${lead.email}</p>
                                    ${phoneDisplay}
                                    <div class="p-3 bg-gray-50 rounded-lg border border-gray-200 mt-2 mb-4">
                                        <p class="text-xs font-semibold text-gray-700 mb-1">Project Details:</p>
                                        <p class="text-sm text-gray-600 truncate">${lead.projectDetails}</p>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-t border-gray-200 space-y-3">
                                    <select data-lead-id="${lead.id}" class="lead-status-select w-full p-2 border border-gray-300 rounded-lg text-sm font-semibold text-center ${getStatusColorClass(currentStatus)} transition duration-200">
                                        ${statusOptions}
                                    </select>
                                    <button data-lead-details='${leadDataJson}' class="analyze-lead-button w-full px-4 py-2 text-sm font-semibold rounded-lg bg-gemini-red text-white hover:bg-red-600 transition duration-300 flex items-center justify-center">
                                        Analyze Lead & Draft Email ✨
                                    </button>
                                </div>
                            </div>
                        `;
                        leadsListContainer.insertAdjacentHTML('beforeend', leadCard);
                    });
                    
                    // Add event listeners for new buttons
                    leadsListContainer.querySelectorAll('.analyze-lead-button').forEach(button => {
                        button.addEventListener('click', handleLeadAnalysis);
                    });

                    // Add change listeners for status dropdowns
                    leadsListContainer.querySelectorAll('.lead-status-select').forEach(select => {
                        // Apply initial color class based on selection
                        select.classList.add(getStatusColorClass(select.value));
                        
                        select.addEventListener('change', (e) => {
                            const leadId = e.target.getAttribute('data-lead-id');
                            const newStatus = e.target.value;
                            
                            // Remove previous status color and add new one
                            allStatuses.forEach(s => select.classList.remove(getStatusColorClass(s)));
                            select.classList.add(getStatusColorClass(newStatus));
                            
                            updateLeadStatus(leadId, newStatus);
                        });
                    });
                }
            }, (error) => {
                console.error("Error getting real-time leads:", error);
                leadsStatus.textContent = "Error loading leads. Check console for details.";
            });
        }

        // --- Gemini Analysis Handler ---
        async function handleLeadAnalysis(event) {
            const button = event.currentTarget;
            let leadDetails;
            try {
                 // Use .replace to safely decode HTML entities like &apos; back to '
                const rawData = button.getAttribute('data-lead-details').replace(/&apos;/g, "'");
                leadDetails = JSON.parse(rawData);
            } catch (e) {
                console.error("Error parsing lead details:", e);
                return;
            }

            const modal = document.getElementById('gemini-modal');
            const contentArea = document.getElementById('modal-content-area');
            const loadingIndicator = document.getElementById('gemini-loading-indicator');
            
            // Show Modal and Loading State
            contentArea.innerHTML = '';
            loadingIndicator.style.display = 'block';
            modal.classList.remove('hidden');

            const systemPrompt = `You are Spade & Scale's senior strategist. Your task is to analyze a new client inquiry. 
            First, provide a one-sentence qualification summary. 
            Second, list the client's 3-5 key marketing needs/challenges based on the project details. 
            Third, draft a concise, professional, and personalized follow-up email from the agency (Spade & Scale) to the client. 
            The tone should be enthusiastic, competent, and focused on scheduling a brief introductory call.`;
            
            const userQuery = `Analyze the following lead from ${leadDetails.name} at ${leadDetails.company}. Project Details: "${leadDetails.projectDetails}"`;

            try {
                const result = await callGeminiApi(userQuery, systemPrompt, responseSchema);
                loadingIndicator.style.display = 'none';

                if (result.error) {
                    contentArea.innerHTML = `<p class="text-red-500 font-semibold">API Error: ${result.error}</p>`;
                    return;
                }
                
                // Format the Key Needs list
                const keyNeedsList = result.keyNeeds.map(need => `<li class="text-sm text-gray-700 list-disc ml-4">${need}</li>`).join('');

                // Format the email body using <br> for line breaks
                const formattedEmailBody = result.draftEmailBody.replace(/\n/g, '<br>');

                // Construct the modal content
                contentArea.innerHTML = `
                    <div class="p-4 bg-primary-blue/10 rounded-lg border border-primary-blue/30">
                        <h4 class="text-lg font-bold text-gray-900 mb-1">Qualification Summary:</h4>
                        <p class="text-primary-blue font-semibold">${result.qualificationSummary}</p>
                    </div>

                    <div class="p-4 bg-gray-100 rounded-lg">
                        <h4 class="text-lg font-bold text-gray-900 mb-2">Key Needs Identified:</h4>
                        <ul class="space-y-1">${keyNeedsList}</ul>
                    </div>
                    
                    <div class="p-4 bg-green-50 rounded-lg border border-green-200">
                        <h4 class="text-lg font-bold text-gray-900 mb-3 flex justify-between items-center">
                            <span>📧 Personalized Email Draft</span>
                            <button id="copy-email-button" class="px-3 py-1 text-xs font-semibold rounded-full bg-accent-teal text-white hover:bg-primary-blue transition duration-300">
                                Copy to Clipboard
                            </button>
                        </h4>
                        
                        <div id="email-content" class="bg-white p-4 rounded-lg border border-gray-200 text-sm font-mono whitespace-pre-wrap">
                            <p class="font-bold">Subject: ${result.draftEmailSubject}</p>
                            <hr class="my-2 border-gray-200">
                            ${formattedEmailBody}
                            <br><br>
                            <p class="font-bold">-- Spade & Scale Team</p>
                        </div>
                    </div>
                `;
                
                // Add copy functionality
                document.getElementById('copy-email-button').addEventListener('click', () => {
                    const emailContent = `Subject: ${result.draftEmailSubject}\n\n${result.draftEmailBody}`;
                    
                    // Fallback clipboard method for iFrame environments
                    const el = document.createElement('textarea');
                    el.value = emailContent;
                    document.body.appendChild(el);
                    el.select();
                    document.execCommand('copy');
                    document.body.removeChild(el);
                    
                    document.getElementById('copy-email-button').textContent = 'Copied!';
                    setTimeout(() => {
                        document.getElementById('copy-email-button').textContent = 'Copy to Clipboard';
                    }, 2000);
                });


            } catch (error) {
                loadingIndicator.style.display = 'none';
                contentArea.innerHTML = `<p class="text-red-500 font-semibold">An unexpected error occurred during analysis: ${error.message}</p>`;
                console.error("Analysis Error:", error);
            }
        }


        // --- Core Application Logic ---
        document.addEventListener('DOMContentLoaded', () => {
            initializeFirebase();

            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            const contactForm = document.getElementById('contact-form');
            const submitButton = document.getElementById('submit-button');
            const loadingSpinner = document.getElementById('loading-spinner');
            const buttonText = document.getElementById('button-text');
            const formMessage = document.getElementById('form-message');
            const currentYear = document.getElementById('current-year');

            // Set current year in footer
            currentYear.textContent = new Date().getFullYear();

            // Mobile Menu Toggle Logic
            mobileMenuButton.addEventListener('click', () => {
                const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true' || false;
                mobileMenuButton.setAttribute('aria-expanded', !isExpanded);
                mobileMenu.classList.toggle('hidden');
            });

            // Close mobile menu when a link is clicked
            mobileMenu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    mobileMenuButton.setAttribute('aria-expanded', 'false');
                });
            });

            // Form Submission Handler
            contactForm.addEventListener('submit', async (event) => {
                event.preventDefault();
                
                // Show loading state
                submitButton.disabled = true;
                buttonText.textContent = 'Submitting...';
                loadingSpinner.classList.remove('hidden');
                formMessage.classList.add('hidden');

                const name = document.getElementById('name').value;
                const email = document.getElementById('email').value;
                const phone = document.getElementById('phone').value; // Get the new phone number
                const company = document.getElementById('company').value;
                const projectDetails = document.getElementById('project_details').value;

                if (!db || !userId) {
                    console.error("Firestore not initialized or user ID missing.");
                    showMessage('Error: Backend service not ready. Please try again.', 'error');
                    resetFormState();
                    return;
                }

                const leadData = {
                    name,
                    email,
                    phone: phone || 'N/A', // Save phone number
                    company: company || 'N/A',
                    projectDetails,
                    submittedAt: new Date(),
                    userId: userId,
                    status: 'New' // Initial status is New
                };

                // Define the collection path for leads
                const collectionPath = `artifacts/${appId}/users/${userId}/agency_leads`;

                try {
                    await addDoc(collection(db, collectionPath), leadData);
                    showMessage('Success! Your inquiry has been submitted and saved securely.', 'success');
                    contactForm.reset();
                } catch (e) {
                    console.error("Error adding document: ", e);
                    showMessage('Error: Failed to save the lead. Please check your connection.', 'error');
                } finally {
                    resetFormState();
                }
            });

            // Utility function to display messages
            function showMessage(message, type) {
                formMessage.textContent = message;
                formMessage.classList.remove('hidden', 'text-accent-teal', 'text-red-500');
                if (type === 'success') {
                    formMessage.classList.add('text-accent-teal', 'font-semibold');
                } else {
                    formMessage.classList.add('text-red-500', 'font-semibold');
                }
            }
            
            // Utility function to reset button and form state
            function resetFormState() {
                submitButton.disabled = false;
                buttonText.textContent = 'Submit Inquiry';
                loadingSpinner.classList.add('hidden');
            }
        });
    </script>

